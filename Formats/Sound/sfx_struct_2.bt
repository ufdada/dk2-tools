/* -*- Mode: C; -*- */
//--------------------------------------
//--- 010 Editor v6.0.3 Binary Template
//
// File:        sfx_struct_2.bt
// Author:      ArchDemon
// Revision:    1.1
// Purpose:     Sound fx
//--------------------------------------
/*
this part parse file correctly but structure - not

Revision 1.1: the unknown fields are named after the code in Dkii.exe v1.70
that reads them (see sfx_struct.bt rev 2.0 for the per-field evidence and a
nested view). Struct mapping to sfx_struct.bt:
    Entry    = SfxEntry   (24 bytes, category header, only entry[0] is used)
    EEntry   = SfxEvent   (20 bytes, one playable event id)
    EEEntry  = SfxGroup   (42 bytes, variant / segment of an event)
    EEEEntry = SfxSample  (16 bytes, one clip)
    Data     = SfxLink    (8 bytes, group transition)
The flat arrays below rely on 010 merging the repeated declarations of
entryGroups[] into one array (entryGroups[k] indexes across all events).
*/
local int i, j, k, n;
local int hSize, eSize, eeSize;

typedef struct
{
    uint toGroup;      // 1-based group index within the same event
    ushort unknown;    // no reader found
    ubyte propertyMin; // transition allowed while voice property 0 is in [min, max]
    ubyte propertyMax;
} Data <read=ReadData, bgcolor=0x8CE6FF>; // , size=8>;

string ReadData( Data &data ) {
    string s;
    SPrintf(s, "-> group %d if %d..%d", data.toGroup, data.propertyMin, data.propertyMax);
    return s;
}

typedef struct {
    uint clip;              // 1-based entry number in the .sdt archive
    uint cumulativeWeight;  // 0..0xFFFF, weighted random pick
    uint durationMs;        // clip length in ms
    ushort bankRef;         // 1-based index into BANK.map's archive list
    ushort padding;         // always 0
} EEEEntry <read=ReadEEEEntry, bgcolor=0xFF8CE6>; // , size=16>;

string ReadEEEEntry( EEEEntry &entry ) {
    string s;
    SPrintf(s, "clip %d (archive %d)", entry.clip, entry.bankRef);
    return s;
}

typedef struct {
    uint sampleCount;       // EEEEntry count
    uint linkCount;         // Data count
    uint samplesPtr;        // runtime pointer, written by the loader
    ubyte volumeMin;        // 0..127, 100 = unity
    ubyte volumeMax;
    byte pitchMin;          // signed
    byte pitchMax;
    ushort delayMin;        // ms
    ushort delayMax;
    ubyte unused_14[2];     // always 0x32 0x32, no reader
    ubyte propertyKey1;
    ubyte unused_17;
    ubyte property1Flags;   // bit 0: volume from property 1, bit 1: pitch from property 1
    ubyte unused_19;
    ubyte propertyKey2;
    ubyte unused_1B;
    ubyte property2Flags;   // same bits for property 2
    ubyte unused_1D;
    ushort cumulativeWeight; // 0..0xFFFF, weighted random group pick
    ushort unused_20;        // always 0
    float maxDistance;      // 3D max distance, 2.0 units per tile
    uint linksPtr;          // runtime pointer, written by the loader
} EEEntry <bgcolor=0xFFB7BC>; // , size=42>;

typedef struct {
    uint id;                // event id the game plays
    uint groupCount;        // EEEntry count (0 = silent event)
    uint groupsPtr;         // runtime pointer, written by the loader
    uint priority;          // voice priority
    uint flags;             // 0x1 deferred, 0x2 segmented, 0x4 repeating, 0x8 loop each,
                            // 0x10 linear sequence, 0x20 backend event, 0x200 2D/head-relative,
                            // 0x400 property links; bits 16-23 = property key 0
} EEntry <read=ReadEEntry, bgcolor=0xBCFFB7>; // , size=20>

string ReadEEntry( EEntry &entry ) {
    string s;
    SPrintf(s, "event %d (0x%X)", entry.id, entry.id);
    return s;
}

typedef struct {
    uint eventCount;        // EEntry count
    uint eventsPtr;         // runtime pointer, written by the loader
    ubyte channelMask;      // 1 master, 2 music, 4 speech, 8 sfx
    ubyte unused_9;
    ushort eaxEnvironment;  // EAX 1.0 preset (13 = stone corridor, 22 = underwater, ...)
    float eaxVolume;
    float eaxDecayTime;     // seconds
    float eaxDamping;
} Entry <bgcolor=0xBCB7FF>; // , size=24>;

uint checkSums[4]<format=hex>;

if (checkSums[0] != 0xE9612C00 || checkSums[1] != 0x11D231D0
    || checkSums[2] != 0xB00009B4 || checkSums[3] != 0x3F293C9) {
    Warning( "Sfx-File is not valid!" );
    Printf( "Sfx-File is not valid!\n" );
    return -1;
}

uint unused_10;  // never read by the loader
uint unused_14;  // never read by the loader
uint count;      // Entry count, always 1

Entry entry[count] <optimize=false>;

eSize = 0;
for(i = 0; i < count; i++ )
{
    eSize += entry[i].eventCount;
}
EEntry entryE[eSize] <optimize=false>;

hSize = 0;
eeSize = 0;
for (i = 0; i < eSize; i++ )
{
    eeSize = entryE[i].groupCount;
    EEEntry entryEE[eeSize] <optimize=false>;

    for (k = hSize; k < hSize + eeSize; k++)
    {
        EEEEntry entryEEE[entryEE[k].sampleCount] <optimize=false>;

        if (entryEE[k].linkCount > 0)
        {
            Data data[entryEE[k].linkCount] <optimize=false>;
        }
    }
    hSize += eeSize;
}
