LittleEndian();

struct Header {
    char magic[4];
    ubyte maxWidth;
    ubyte maxHeight;
    ushort offsetCount;
    uint offsets[offsetCount];
} header;

struct FontEntry {
    char chr[2];
    ubyte gap_2[2]; // unused
    ubyte gap_4[4]; // unused
    uint dataSize;
    ubyte flags;
    ubyte gap_3[3]; // unused
    ushort width;
    ushort height;
    byte offsetX;
    byte offsetY;
    short outerWidth;
    if (width > 0 && height > 0) {
        byte image[dataSize]<optimize=false>;
    }
} entries[header.offsetCount]<optimize=false>;