typedef struct LevelFlag {
    byte none_1 : 1;
    byte none_2 : 1;
    byte UNK_1 : 1; // always on?!
    byte ALWAYS_IMPRISON_ENEMIES : 1;
    byte ONE_SHOT_HORNY : 1;
    byte IS_SECRET_LEVEL : 1;
    byte IS_SPECIAL_LEVEL : 1;
    byte SHOW_HERO_KILLS : 1;
    byte AUTO_OBJECTIVE_BOX : 1;
    byte HEART_MAKES_GEM : 1;
    byte IS_MULTIPLAYER_LEVEL : 1;
    byte IS_SKIRMISH_LEVEL : 1;
    byte FREEZE_OPTIONS : 1;
    byte IS_MY_PET_DUNGEON_LEVEL : 1;
    byte none_3 : 1;
    byte none_4 : 1;
};

// Names = the game's own reward table (Dkii.exe arr_66C780, also DK2 Editor.exe 0x5103F8):
// 16-byte records {id, wchar* name, ushort previousSpeechId, ushort currentSpeechId, uint flag (0 on keeper spells)}
enum <ubyte> LevelReward {
    NO_REWARD = 0,
    ALARM_REWARD = 1,
    BARRICADE_REWARD = 2,
    BOULDER_REWARD = 3,
    BRACED_REWARD = 4,
    BRIDGE_STONE_REWARD = 5,
    BRIDGE_WOODEN_REWARD = 6,
    CALL_TO_ARMS_REWARD = 7,
    CASINO_REWARD = 8,
    CHICKEN_REWARD = 9,
    CREATE_GOLD_REWARD = 10,
    CREATE_IMP_REWARD = 11,
    DARK_LIBRARY_REWARD = 12,
    EARTHQUAKE_REWARD = 13, // Tremor spell
    FEAR_REWARD = 14,
    FIREBURST_REWARD = 15,
    FREEZE_REWARD = 16,
    GAS_REWARD = 17,
    GRAVEYARD_REWARD = 18,
    GUARD_ROOM_REWARD = 19,
    GUARD_POST_REWARD = 20,
    HATCHERY_REWARD = 21,
    HEAL_REWARD = 22,
    INFERNO_REWARD = 23,
    LAIR_REWARD = 24,
    LIGHTNING_REWARD = 25,
    MAGIC_DOOR_REWARD = 26,
    PIT_REWARD = 27,
    POSSESS_REWARD = 28,
    PRISON_REWARD = 29,
    REAPER_TALISMAN_4_REWARD = 30,
    FIGHT_REWARD = 31, // no speech, no icon category; unused
    SECRET_DOOR_REWARD = 32,
    SENTRY_REWARD = 33,
    SIGHT_OF_EVIL_REWARD = 34,
    SPIKE_REWARD = 35,
    STEEL_DOOR_REWARD = 36,
    SUMMON_REAPER_REWARD = 37, // Summon Horny spell
    NOT_USED_38 = 38, // "<Not Used>"
    TEMPLE_REWARD = 39,
    THUNDERBOLT_REWARD = 40,
    TORTURE_REWARD = 41,
    TRAINING_REWARD = 42,
    TREASURY_REWARD = 43,
    TRIGGER_REWARD = 44,
    TURNCOAT_REWARD = 45,
    NOT_USED_46 = 46, // "<Not Used>"
    WOOD_DOOR_REWARD = 47,
    WORK_SHOP_REWARD = 48,
    REAPER_TALISMAN_1_REWARD = 49,
    REAPER_TALISMAN_2_REWARD = 50,
    REAPER_TALISMAN_3_REWARD = 51
};

