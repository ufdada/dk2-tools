typedef struct {
    ubyte PLACEABLE_ON_WATER : 1;
    ubyte PLACEABLE_ON_LAVA : 1;
    ubyte PLACEABLE_ON_LAND : 1;
    ubyte HAS_WALLS : 1;
    ubyte CENTER : 1; // Placement
    ubyte SPECIAL_TILES : 1; // Placement
    ubyte NORMAL_TILES : 1; // Placement
    ubyte BUILDABLE : 1;
    ubyte SPECIAL_WALLS : 1; // Placement
    ubyte TORCH_COLOR_RED : 1;
    ubyte TORCH_COLOR_GREEN : 1; // Hero Gate [ Final ], Hero Gate [ Tile ] [ not used ]
    ubyte TORCH_COLOR_BLUE : 1; // Hero Gate [ Final ], Hero Gate [ Tile ] [ not used ]
    ubyte HAS_FLAME : 1;
    ubyte IS_GOOD : 1;
	ubyte none[2];
} RoomFlag;

enum <ubyte> TileConstruction {
	NO_CONSTRUCTION,
	COMPLETE,
	QUAD_CONSTRUCTION,
	_3_BY_3,
	_3_BY_3_ROTATED,
	NORMAL_CONSTRUCTION,
	CENTER_POOL,
	DOUBLE_QUAD,
	_5_BY_5_ROTATED,
	HERO_GATE,
	HERO_GATE_TILE,
	HERO_GATE_2_BY_2,
	HERO_GATE_FRONT_END_TILE,
	HERO_GATE_3_BY_1
};

typedef struct {
	char name[32];
	ArtResource guiIcon;
	ArtResource editorIcon;
	ArtResource completeResource;
	ArtResource straightResource;
	ArtResource insideCornerResource;
	ArtResource nullResource; // always null
	ArtResource outsideCornerResource;
	ArtResource wallResource;
	ArtResource capRecource;
	ArtResource ceilingResource;
	float32 ceilingHeight;
	ushort researchTime; // maybe. Not changed in editor
	ushort torchIntensity;
	RoomFlag flags;
	ushort toolTipStringId;
	ushort nameStringId;
	ushort cost;
	ushort fightEffectId;
	ushort generalDescriptionStringId;
	ushort strengthStringId;
	float16 torchHeight;
	ushort roomEffects[8];
	ubyte roomId;
	ubyte returnPercentage;
	ubyte terrainId;
	TileConstruction construction;
	ubyte createdCreatureId;
	ColorRGB torchColor;
	ubyte objectsIds[8];
	char soundCategory[32];
	ubyte orderInEditor;
    float32 torchRadius;
	ArtResource torch;
	ubyte recommendedSizeX;
	ubyte recommendedSizeY;
	ushort healthGain;
} RoomData<read=getRoomName>;

string getRoomName(RoomData &item) {
    return item.name;
}
